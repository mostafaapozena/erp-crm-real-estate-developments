# ---------------------------------------------------------------------------
# Local database files and data dumps
# ---------------------------------------------------------------------------
data/
mongo-data/
mongodb/
redis-data/
dump.rdb
appendonly.aof
*.sqlite
*.sqlite3
*.db
*.mdb
*.bson
*.dump
*.sql
!docs/**/*.sql
db-backups/
backups/

# ---------------------------------------------------------------------------
# Uploaded and sensitive business documents
# Real customer, employee, contract, bank, check, and ID documents must never
# be committed. Use private S3 storage. Only anonymised fixtures are allowed.
# ---------------------------------------------------------------------------
uploads/
storage/
private/
attachments/
documents/
scans/
contracts-signed/
payroll-exports/
bank-statements/
customer-documents/
employee-documents/
*.ofx
*.qif
*.camt
*.mt940

