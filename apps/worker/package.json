{
  "name": "@alola/worker",
  "version": "0.1.0",
  "private": true,
  "description": "ALOLA ERP background worker (BullMQ)",
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/bin.mjs tsx watch --env-file-if-exists=../../.env src/main.ts",
    "start": "node --env-file-if-exists=../../.env --enable-source-maps dist/main.js",
    "build": "node ../../scripts/build-node-app.mjs src/main.ts dist/main.js",
    "typecheck": "node ../../scripts/bin.mjs tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@alola/config": "0.1.0",
    "@alola/security": "0.1.0",
    "bullmq": "6.3.8",
    "ioredis": "6.0.0"
  },
  "devDependencies": {
    "@alola/testing": "0.1.0"
  }
}
