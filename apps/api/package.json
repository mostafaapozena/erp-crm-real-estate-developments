{
  "name": "@alola/api",
  "version": "0.1.0",
  "private": true,
  "description": "ALOLA ERP REST API (Express)",
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/bin.mjs tsx watch --env-file-if-exists=../../.env src/main.ts",
    "start": "node --env-file-if-exists=../../.env --enable-source-maps dist/main.js",
    "build": "node ../../scripts/build-node-app.mjs src/main.ts dist/main.js",
    "typecheck": "node ../../scripts/bin.mjs tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@alola/config": "0.1.0",
    "@alola/contracts": "0.1.0",
    "@alola/security": "0.1.0",
    "cors": "2.8.6",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "mongoose": "9.10.1",
    "pino-http": "11.0.0",
    "rate-limiter-flexible": "11.2.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@alola/testing": "0.1.0",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/supertest": "7.2.1",
    "supertest": "7.2.2"
  }
}
