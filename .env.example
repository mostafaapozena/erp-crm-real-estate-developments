# ALOLA ERP — environment template (OPS-002)
#
# Copy to `.env` (untracked) and fill in DEVELOPMENT values only.
# This file contains placeholders only. Never put a real credential here, and never use
# production credentials or production services from development (ADR-0015, ADR-0018).
# A unit test checks that this file lists exactly the variables in packages/config/src/env.ts.

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
# development | test | staging | production. staging and production require the data services below.
APP_ENV=development
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Required, exactly UTC (ADR-0008). Storage is UTC; the organization timezone is for display.
TZ=UTC

# --- Organization ----------------------------------------------------------
# IANA timezone for display and business dates. PLACEHOLDER pending stakeholder decision SD-21.
ORG_TIMEZONE=UTC
# ar | en. Arabic is the product default.
DEFAULT_LOCALE=ar

# --- API ---------------------------------------------------------------------
PORT=4000
# Comma-separated bare origins allowed by CORS. Wildcards are rejected.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
# Number of trusted reverse-proxy hops in front of the API (0 when none).
TRUST_PROXY_HOPS=0
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=300

# --- MongoDB (Atlas DEVELOPMENT cluster — ADR-0018) --------------------------
# Leave empty to run without a database; readiness reports "not_configured".
# Format: mongodb+srv://<user>:<password>@<cluster-host>/
MONGODB_URI=
# Development database name. Names containing "prod" are refused outside production.
MONGODB_DB_NAME=

# --- Redis (managed development instance or approved local instance) --------
# Leave empty to run the API without Redis. The worker requires it.
# Format: rediss://<user>:<password>@<host>:<port>
REDIS_URL=

# --- Worker ------------------------------------------------------------------
WORKER_CONCURRENCY=4

# --- Private files and encryption (not configured in development yet) ------
S3_BUCKET=
S3_REGION=
KMS_KEY_ID=
