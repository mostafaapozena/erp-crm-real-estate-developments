{
  "name": "@alola/web",
  "version": "0.1.0",
  "private": true,
  "description": "ALOLA ERP web application (React, Vite, Material UI)",
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/bin.mjs vite",
    "build": "node ../../scripts/bin.mjs vite build",
    "preview": "node ../../scripts/bin.mjs vite preview --port 4173 --strictPort",
    "typecheck": "node ../../scripts/bin.mjs tsc --noEmit -p tsconfig.json",
    "test:e2e": "node ../../scripts/bin.mjs playwright test"
  },
  "dependencies": {
    "@alola/i18n": "0.1.0",
    "@alola/ui": "0.1.0",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@fontsource/alexandria": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@mui/material": "9.4.0",
    "i18next": "26.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "29.1.1",
    "vite": "8.3.0"
  }
}
