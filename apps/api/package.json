{
  "name": "@alola/api",
  "version": "0.1.0",
  "private": true,
  "description": "Real-estate ERP REST API (Express)",
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/bin.mjs tsx watch --env-file-if-exists=../../.env src/main.ts",
    "start": "node --env-file-if-exists=../../.env --enable-source-maps dist/main.js",
    "build": "node ../../scripts/build-node-app.mjs src/main.ts dist/main.js",
    "typecheck": "node ../../scripts/bin.mjs tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@alola/config": "0.1.0",
    "@alola/contracts": "0.1.0",
    "@alola/i18n": "0.1.0",
    "@alola/security": "0.1.0",
    "@alola/ui": "0.1.0",
    "@fontsource/alexandria": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "bidi-js": "1.1.0",
    "cors": "2.8.6",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "mongoose": "9.10.1",
    "pdfkit": "0.20.2",
    "pino-http": "11.0.0",
    "qrcode-generator": "2.0.4",
    "rate-limiter-flexible": "11.2.1",
    "read-excel-file": "9.3.10",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@alola/testing": "0.1.0",
    "@napi-rs/canvas": "1.0.9",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/pdfkit": "0.17.6",
    "@types/supertest": "7.2.1",
    "jsqr": "1.4.0",
    "pdfjs-dist": "6.3.289",
    "supertest": "7.2.2"
  }
}
