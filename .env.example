# Real-estate ERP — environment template (OPS-002). One deployment per client company (ADR-0027).
#
# Copy to `.env` (untracked) and fill in DEVELOPMENT values only.
# This file contains placeholders only. Never put a real credential here, and never use
# production credentials or production services from development (ADR-0015, ADR-0018).
# A unit test checks that this file lists exactly the variables in packages/config/src/env.ts.

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
# development | test | staging | production. staging and production require the data services below.
APP_ENV=development
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Required, exactly UTC (ADR-0008). Storage is UTC; the organization timezone is for display.
TZ=UTC

# --- Organization ----------------------------------------------------------
# IANA timezone for display and business dates. PLACEHOLDER pending stakeholder decision SD-21.
ORG_TIMEZONE=UTC
# ar | en. Arabic is the product default.
DEFAULT_LOCALE=ar

# --- API ---------------------------------------------------------------------
PORT=4000
# Comma-separated bare origins allowed by CORS. Wildcards are rejected.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
# Number of trusted reverse-proxy hops in front of the API (0 when none).
TRUST_PROXY_HOPS=0
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=300
# Sign-in attempts per address per 15 minutes. Staging and production refuse values above 120.
AUTH_LOGIN_IP_MAX_ATTEMPTS=120

# --- MongoDB (Atlas DEVELOPMENT cluster — ADR-0018) --------------------------
# Leave empty to run without a database; readiness reports "not_configured".
# Format: mongodb+srv://<user>:<password>@<cluster-host>/
MONGODB_URI=
# Development database name. Names containing "prod" are refused outside production.
MONGODB_DB_NAME=

# --- Redis (managed development instance or approved local instance) --------
# Leave empty to run the API without Redis. The worker requires it.
# Format: rediss://<user>:<password>@<host>:<port>
REDIS_URL=

# --- Worker ------------------------------------------------------------------
WORKER_CONCURRENCY=4

# --- Private files and encryption (not configured in development yet) ------
# Development and test only: where uploaded documents are stored. Ignored by Git.
FILE_STORAGE_DIR=.local-storage
S3_BUCKET=
S3_REGION=
KMS_KEY_ID=

# --- Authentication (SEC-013 … SEC-017, ADR-0023) ---------------------------
# HS256 signing key for access tokens and MFA challenges. At least 32 characters of random
# material, generated locally per environment. There is deliberately no default: a default would be
# a shared key. Required when APP_ENV is staging or production.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
AUTH_TOKEN_SIGNING_SECRET=
# Access tokens are short-lived; revocation does not wait for them to expire.
AUTH_ACCESS_TOKEN_TTL_SECONDS=600
# Sessions end after this much inactivity, and in any case at the absolute timeout.
AUTH_SESSION_IDLE_TIMEOUT_SECONDS=1800
AUTH_SESSION_ABSOLUTE_TIMEOUT_SECONDS=43200
# Invitation links and password-reset links.
AUTH_ACTIVATION_TOKEN_TTL_SECONDS=259200
AUTH_PASSWORD_RESET_TTL_SECONDS=1800
# How long a second-factor challenge stays valid during sign-in.
AUTH_MFA_CHALLENGE_TTL_SECONDS=300
# Authenticator label used only until a company profile exists; the profile's short name wins.
AUTH_TOTP_ISSUER=Real Estate ERP
# Argon2id cost parameters (OWASP minimum). Raising them rehashes on the next successful login.
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
# DEVELOPMENT AND TEST ONLY: 32-byte base64 key that encrypts MFA secrets so an enrolment survives a
# restart. Refused when APP_ENV is staging or production, which require KMS_KEY_ID (SEC-033).
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
DEV_ENCRYPTION_KEY=
