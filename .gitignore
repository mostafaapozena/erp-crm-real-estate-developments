# ALOLA ERP — repository hygiene
# Rule: never commit secrets, credentials, production data, or customer documents.
# See docs/decisions/adr-0015-secrets-and-repository-hygiene.md

# ---------------------------------------------------------------------------
# Environment and secrets
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.env
!example.env
.envrc
secrets/
.secrets/
config/local.*
config/secrets.*

# Cloud / provider credentials
.aws/
.aws-credentials
aws-exports.js
gcloud-service-key.json
service-account*.json
firebase-adminsdk*.json
.npmrc
.yarnrc
.yarnrc.yml
.netrc

# ---------------------------------------------------------------------------
# Private keys, certificates, and access tokens
# ---------------------------------------------------------------------------
*.pem
*.key
*.p12
*.pfx
*.p8
*.jks
*.keystore
*.crt
*.cer
*.der
*.csr
*.asc
*.gpg
*.kdbx
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
known_hosts
*.token
*token.json
*credentials.json
*.session

# ---------------------------------------------------------------------------
# Generated demonstration credentials
# Written by `npm run seed:demo` and containing working passwords and TOTP
# secrets for the local development database. Never commit it.
# ---------------------------------------------------------------------------
.demo-credentials.md

